# Copy this file to .env and fill in what you need. Everything is optional.

# Reasoning engine: auto | local | anthropic | openai | groq | gemini | ollama
LLM_PROVIDER=auto
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# E-mail sent to OpenAlex / Crossref / Unpaywall ("polite pool", faster & more reliable)
CONTACT_EMAIL=

# Optional Semantic Scholar key (higher rate limit)
S2_API_KEY=

# 1 = run fully offline on the bundled demo corpus
AUTHORSHAND_DEMO=0
